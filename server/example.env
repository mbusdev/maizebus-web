# Email Configuration
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_USER=contact@maizebus.com
EMAIL_PASS=<app password for contact email>
EMAIL_TO=contact@maizebus.com

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=https://maizebus.com

# Poster tracking links (/go/<slug>)
# Where click records are appended (JSON lines). Keep this outside the deploy dir in prod.
CLICK_LOG_PATH=./poster-clicks.jsonl
# Secret for GET /go/stats?key=... ; stats are disabled if unset.
STATS_KEY=<long random string>
# Where /go/<slug> redirects to (default https://www.maizebus.com)
POSTER_REDIRECT_URL=https://www.maizebus.com
